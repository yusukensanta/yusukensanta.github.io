# Portfolio opt-in configuration for yusukensanta.github.io
# Copy this file to .github/portfolio.yml in your repository.

# Set to false to temporarily remove from the portfolio without deleting this file.
enabled: true

# Override the display title (defaults to repository name)
# title: "My Awesome Project"

# Override the description (defaults to GitHub repository description)
# description: "A short description shown on the index and project pages."

# Link to a live demo or production deployment (optional)
# homepage: "https://example.com"

# Tech stack tags shown on the project card and detail page (optional)
# tech_stack:
#   - Python
#   - FastAPI
#   - PostgreSQL

# --- Japanese translation (automatic, no config needed) ---
# Your title, description, README overview, installation, and contributing
# sections are auto-translated to Japanese and published under /ja/.
# Nothing to set here — just be aware of two limits:
#   - Any single field over 5,000 characters is skipped (that field falls
#     back to showing the English text on the Japanese page instead).
#   - Translation runs on a DeepL API key shared across every repo on this
#     portfolio, with a 1,000,000-character LIFETIME budget (does not
#     reset monthly). Very large or very frequently-changing READMEs use
#     up more of that shared budget.
