---
import type { Locale } from '../i18n/paths';
import { toLocalePath } from '../i18n/paths';
import { t, splitTemplate } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}
const { title, description = 'Open source projects by yusukensanta', locale = 'en' } = Astro.props;
const siteUrl = 'https://yusukensanta.github.io';
const homeHref = toLocalePath('/', locale);
const otherLocale: Locale = locale === 'en' ? 'ja' : 'en';
const switcherHref = toLocalePath(Astro.url.pathname, otherLocale);
const [footerBefore, footerAfter] = splitTemplate(t(locale, 'footer.built'), '{astroLink}');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="site-nav">
      <div class="container nav-inner">
        <a class="nav-brand" href={homeHref}>yusukensanta</a>
        <div class="nav-links">
          <a href="https://github.com/yusukensanta" target="_blank" rel="noopener">{t(locale, 'nav.github')}</a>
          <a class="lang-switch" href={switcherHref}>{t(locale, 'nav.lang')}</a>
        </div>
      </div>
    </nav>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{footerBefore}<a href="https://astro.build">Astro</a>{footerAfter}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  .site-nav {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0;
    position: sticky;
    top: 0;
    background: var(--color-bg);
    z-index: 10;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
  }
  .nav-links { display: flex; align-items: center; gap: 1rem; }
  .lang-switch { color: var(--color-text-muted); }
  main { padding: 2rem 1.5rem; }
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0;
    margin-top: 4rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-align: center;
  }
</style>
