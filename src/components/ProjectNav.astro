---
import type { Locale } from '../i18n/paths';
import { toLocalePath } from '../i18n/paths';
import { t } from '../i18n/ui';

interface Props {
  slug: string;
  current: 'overview' | 'installation' | 'contribution';
  hasInstallation: boolean;
  hasContribution: boolean;
  locale?: Locale;
}
const { slug, current, hasInstallation, hasContribution, locale = 'en' } = Astro.props;
---

<nav class="project-subnav" aria-label={t(locale, 'aria.projectSections')}>
  <a
    href={toLocalePath(`/projects/${slug}/`, locale)}
    class:list={['subnav-link', { active: current === 'overview' }]}
  >
    {t(locale, 'nav.overview')}
  </a>
  {hasInstallation && (
    <a
      href={toLocalePath(`/projects/${slug}/installation/`, locale)}
      class:list={['subnav-link', { active: current === 'installation' }]}
    >
      {t(locale, 'nav.installation')}
    </a>
  )}
  {hasContribution && (
    <a
      href={toLocalePath(`/projects/${slug}/contribution/`, locale)}
      class:list={['subnav-link', { active: current === 'contribution' }]}
    >
      {t(locale, 'nav.contributing')}
    </a>
  )}
</nav>

<style>
  .project-subnav {
    display: flex;
    gap: 0;
    border-bottom: 2px solid var(--color-border);
    margin: 0 0 2rem;
  }
  .subnav-link {
    padding: 0.65rem 1.25rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .subnav-link:hover { color: var(--color-text); text-decoration: none; }
  .subnav-link.active {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    font-weight: 600;
  }
</style>
