---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ProjectHeader from '../../../../components/ProjectHeader.astro';
import ProjectNav from '../../../../components/ProjectNav.astro';
import { t, splitTemplate } from '../../../../i18n/ui';
import type { Project } from '../../../../content.config';

const locale = 'ja' as const;

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries
    .filter(e => (e.data as Project).sections.contributing?.trim())
    .map(entry => ({
      params: { slug: entry.id },
      props: { project: entry.data as Project },
    }));
}

const { project } = Astro.props;
const translated = project.translations?.ja;
const content = translated?.sections.contributing || project.sections.contributing;
const rendered = marked.parse(content) as string;
const title = translated?.title || project.title;
const description = translated?.description || project.description;
const [contributeDescBefore, contributeDescAfter] = splitTemplate(t(locale, 'meta.contributeDescription'), '{title}');
const metaDescription = `${contributeDescBefore}${title}${contributeDescAfter}`;
---

<BaseLayout
  title={`${title} — ${t(locale, 'nav.contributing')} — yusukensanta`}
  description={metaDescription}
  locale={locale}
>
  <ProjectHeader project={project} locale={locale} title={title} description={description} />
  <ProjectNav
    slug={project.slug}
    current="contribution"
    hasInstallation={!!project.sections.installation?.trim()}
    hasContribution={true}
    locale={locale}
  />
  <section class="prose" set:html={rendered} />
</BaseLayout>
